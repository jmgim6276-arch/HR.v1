# ── 密钥与凭据（只放服务器 / 本机不进库）──
.env
.env.*
!.env.example
*.pem

# ── 用户数据（开发库/孤儿库，生产库在服务器）──
*.db

# ── Python 运行环境 ──
venv/
__pycache__/
*.pyc

# ── 历史还原点（git 之前的备份约定，保留在磁盘、不进库）──
_core_backup_*/

# ── 分发产物（打包出来的安装档，源码以 extension/ 为准）──
凯旋智聘-*.zip
凯旋智聘-*-客户安装版*/
*.map

# ── 系统/工具 ──
.DS_Store
node_modules/
