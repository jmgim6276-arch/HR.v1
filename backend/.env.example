# 复制为 .env 并按需修改（生产环境务必改 JWT_SECRET / ADMIN_KEY，接好邮件后设 DEV_MODE=false）
DEV_MODE=true
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=admin-secret-change-me
DB_PATH=app.db

# ── 邮件发验证码（配好后即可关掉 DEV_MODE）──
# 阿里云邮件推送（需先验证域名+创建发信地址）：
#   SMTP_HOST=smtpdm.aliyun.com
#   SMTP_PORT=465
#   SMTP_USER=no-reply@mail.你的域名.com
#   SMTP_PASS=发信地址的SMTP密码
# QQ邮箱（无需域名，适合先测）：
#   SMTP_HOST=smtp.qq.com  SMTP_PORT=465
#   SMTP_USER=你的@qq.com   SMTP_PASS=QQ邮箱授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=智能招聘助手

# ── 呼波特合作方接口（仅配置在后端，禁止写入插件源码）──
WHOBOT_BASE_URL=https://partner.whobot.com/
WHOBOT_TOKEN=
# 呼波特分配的渠道密钥；后端会据此动态计算 SHA1 Signature。
WHOBOT_SIGNATURE=
WHOBOT_TIMEOUT_SECONDS=15

# ── 呼波特电话话单回调（PushUrl 指向本服务，密钥仍只放后端）──
# PushUrl: https://你的域名/api/v1/integrations/whobot/callback
WHOBOT_CALLBACK_APP_ID=
WHOBOT_CALLBACK_APP_SECRET=
WHOBOT_CALLBACK_MAX_CLOCK_SKEW_SECONDS=300
WHOBOT_CALLBACK_MAX_BODY_BYTES=2097152

# ── 点数计费（大模型托管按量付费；以下均为默认值，不改也能跑）──
# 1 点 = 多少 token（混合价，输入输出不分；默认 50000，即 1 元=10 点=50 万 token）
BILLING_TOKENS_PER_POINT=50000
# 新用户注册赠送体验点
BILLING_SIGNUP_BONUS_POINTS=50
# 单用户每日消耗上限（防自动化失控/盗用一夜烧光，0=不限）
BILLING_DAILY_LIMIT_POINTS=200
# 低余额预警阈值（轻提示 / 强提示）
BILLING_WARN_SOFT_POINTS=5
BILLING_WARN_HARD_POINTS=0.5

# ── 托管大模型（阿里 dashscope OpenAI 兼容模式；密钥只放服务器，插件永不接触）──
# 阿里后台→API-KEY 管理创建；生产必填，缺失时 LLM 端点返回 503
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 固定一款模型，用户不可选；qwen-plus 质量优先，qwen-turbo 更便宜更快
LLM_MODEL=qwen-plus
# max_tokens 服务端硬封顶（插件传更大也会被压回）
LLM_MAX_TOKENS_CAP=2000
# 单用户每分钟调用上限（防脚本滥用）
LLM_RATE_LIMIT_PER_MIN=20
LLM_TIMEOUT_SECONDS=60
